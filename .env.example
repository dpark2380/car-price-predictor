# Marketcheck API (required for ingestion — get a key at marketcheck.com)
MARKETCHECK_API_KEY=

# Optional — uncomment to override the defaults baked into the code.
# MARKETCHECK_ZIP=94119
# MARKETCHECK_RADIUS=100

# Optional — Flask API port.
# PORT=5001

# Optional — scheduler / training tuning.
# INACTIVE_AFTER_DAYS=180
# MIN_TRAINING_SAMPLES=140
# STALE_LISTING_MAX_DAYS=365
